# IoTMonSys Backend Configuration
# ==============================

# Database Settings
# ----------------

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
MONGODB_URI_LEGACY=mongodb+srv://username:password@cluster.mongodb.net/iotmonsys

# PostgreSQL AWS RDS Connection
POSTGRES_DB_NAME=iotmonsys
POSTGRES_DB_USER=postgres
POSTGRES_DB_PASSWORD=your_password
POSTGRES_DB_HOST=your-rds-instance.region.rds.amazonaws.com
POSTGRES_DB_PORT=5432

# Server Settings
# --------------
PORT=5000
NODE_ENV=development  # Options: development, test, production

# Security Settings
# ---------------
# Secret key for JWT token generation and verification (if shorten than 32bit, it will be padded to required length)
JWT_SECRET=your_jwt_secret_key_recomended_least_32_chars_long

# Logger Settings
# --------------
# Log format: 'text' for human-readable format with brackets, 'json' for structured JSON format
LOG_FORMAT=text

# Minimum log level to output: debug, info, warn, error, alert
LOG_LEVEL=debug