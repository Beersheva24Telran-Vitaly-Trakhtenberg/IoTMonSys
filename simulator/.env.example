# IoT Device Simulator Configuration
# ===============================

# Simulator Settings
# -----------------
# Number of virtual IoT devices to generate
DEVICE_COUNT=5

# Interval between data transmissions in milliseconds
SEND_INTERVAL=5000

# UDP configuration for sending device data
UDP_PORT=41234
UDP_HOST=localhost

# TCP port for receiving commands to control the simulator
COMMAND_PORT=41235

# Percentage chance (0-100) of generating anomalous data
ANOMALY_RATE=5

# Logger Settings
# --------------
# Log format: 'text' for human-readable format with brackets, 'json' for structured JSON format
LOG_FORMAT=text

# Minimum log level to output: debug, info, warn, error, alert
LOG_LEVEL=debug

# Environment: development, test, production
NODE_ENV=development