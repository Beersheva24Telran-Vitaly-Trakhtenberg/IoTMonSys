# IoTMonSys UDP-Listener Configuration
# ===================================

# MongoDB Connection
# -----------------
# URI for MongoDB Atlas connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?<options>
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/iotmonsys?retryWrites=true&w=majority

# UDP Listener Settings
# -------------------
# Port for UDP server to listen for device data
UDP_PORT=41234
# Host for UDP server (0.0.0.0 to listen on all interfaces)
UDP_HOST=0.0.0.0
# Port for REST API server
API_PORT=3001

# Device Discovery Mode
# -------------------
# Enable automatic discovery of new devices (true/false)
DISCOVERY_MODE_ENABLED=false
# Duration in milliseconds for discovery mode when enabled
DISCOVERY_MODE_DURATION=60000

# AWS Kinesis Integration
# ---------------------
# Enable sending data to AWS Kinesis (true/false)
USE_KINESIS=false
# AWS Region for Kinesis
AWS_REGION=us-east-1
# AWS Access Key ID
AWS_ACCESS_KEY_ID=your_access_key_id
# AWS Secret Access Key
AWS_SECRET_ACCESS_KEY=your_secret_access_key
# Kinesis Stream Name
KINESIS_STREAM_NAME=iotmonsys-device-data

# AWS CloudWatch Integration
# ------------------------
# Enable sending logs to AWS CloudWatch (true/false)
AWS_CLOUDWATCH_ENABLED=false
# CloudWatch Log Group name
AWS_CLOUDWATCH_GROUP=IoTMonSys-Logs
# CloudWatch Log Stream name
AWS_CLOUDWATCH_STREAM=udp-listener

# Logger Settings (@vitaly-yosef/node-smart-logger)
# --------------
# Log format: 'text' for human-readable format with brackets, 'json' for structured JSON format
LOG_FORMAT=text
# Minimum log level to output: debug, info, warn, error, alert
LOG_LEVEL=debug
# Environment: development, test, production
NODE_ENV=development
# Service name for logs
SERVICE_NAME=udp-listener
# Path to logs directory
LOGS_PATH=./logs