{
  "name": "iotmonsys",
  "version": "1.0.0",
  "private": true,
  "author": "Vitaly Trakhtenberg",
  "description": "The IoT-devices monitoring system, based on microservice architect using AWS cloud services",
  "license": "ISC",
  "keywords": [],
  "type": "module",
  "workspaces": [
    "backend",
    "lambdas",
    "simulator",
    "udp-listener",
    "infra"
  ],
  "scripts": {
    "start:backend": "yarn workspace @iotmonsys/backend start",
    "start:udp-listener": "yarn workspace @iotmonsys/udp-listener start",
    "start:simulator": "yarn workspace @iotmonsys/simulator start",
    "dev:backend": "yarn workspace @iotmonsys/backend dev",
    "dev:udp-listener": "yarn workspace @iotmonsys/udp-listener dev",
    "dev:simulator": "yarn workspace @iotmonsys/simulator dev",
    "build": "yarn workspaces run build",
    "test": "yarn workspaces run test",
    "prepare": "husky install",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "clean": "rm -rf .yarn/install-state.gz && rm -rf node_modules && rm -rf */node_modules",
    "reinstall": "rm -rf .yarn/install-state.gz && rm -rf node_modules && rm -rf */node_modules && yarn install"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "husky": "^8.0.0",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.485.0",
    "@vitaly-yosef/node-smart-logger": "^1.2.3",
    "mongodb": "^6.15.0"
  },
  "packageManager": "yarn@4.9.2"
}
